<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Calculadora Simples</title>
</head>
<body>
    <h1>Calculadora</h1>
    <input type="number" id="n1" placeholder="Digite o primeiro número">
    <input type="number" id="n2" placeholder="Digite o segundo número">
    <button onclick="somar()">Enviar</button>
    <p id="resultado"></p>
    <script>
        function somar(){
            let n1 = Number(document.getElementById("n1").value);
            let n2 = Number(document.getElementById("n2").value);
            let soma = n1 + n2;
            document.getElementById("resultado").textContent = "Resultado: " + soma;
        }
    </script>
</body>
</html>
