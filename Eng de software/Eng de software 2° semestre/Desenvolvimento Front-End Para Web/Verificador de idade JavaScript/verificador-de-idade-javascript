<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Verificador de Idade</title>
</head>
<body>
    <h1>Verificador de Idade</h1>
    <input type="number" id="idade" placeholder="Digite a sua idade:">
    <button onclick="verificaridade()">Enviar</button>
    <p id="resultado"></p>
    <script>
        function verificaridade(){
            let idade = Number(document.getElementById("idade").
            value);
            if(idade >= 18){
                document.getElementById("resultado").textContent = 
                "Você tem " + idade + " anos. Você é maior de idade";
            }else{
                document.getElementById("resultado").textContent =
                "Você tem " + idade + " anos. Você é menor de idade";
            }
        }
    </script>
</body>
</html>
